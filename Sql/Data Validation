--PRODUCT PERFORMANCE--

--LEAST PERFORMING PRODUCT--

SELECT SUM(Quantity * UnitPrice) AS Revenue, 
SUM(Quantity) AS TotalUnitSold,
COUNT(DISTINCT InvoiceNo) AS TotalOrders,
StockCode
FROM clean_transonly
GROUP BY StockCode
ORDER BY SUM(Quantity * UnitPrice) ASC     --By Reveneue

SELECT SUM(Quantity * UnitPrice) AS Revenue, 
SUM(Quantity) AS TotalUnitSold,
COUNT(DISTINCT InvoiceNo) AS TotalOrders,
StockCode
FROM clean_transonly
GROUP BY StockCode
HAVING COUNT(InvoiceNo) <= 1
ORDER BY TotalOrders ASC      --By Orders

SELECT SUM(Quantity * UnitPrice) AS Revenue, 
SUM(Quantity) AS TotalUnitSold,
COUNT(DISTINCT InvoiceNo) AS TotalOrders,
StockCode
FROM clean_transonly
GROUP BY StockCode
HAVING SUM(Quantity) <= 1
ORDER BY TotalOrders ASC      --By Quantity Sold


--MOST ITEM IN DEMAND

SELECT TOP 1 StockCode,SUM(Quantity) As TotalUnitSold FROM clean_transonly
GROUP BY StockCode
ORDER BY TotalUnitSold DESC


--SALE TREND OF TOP 10 PRODUCT--

SELECT Revenue, Date, Month ,StockCode, rn
FROM
( SELECT SUM(Quantity * UnitPrice) AS Revenue,
FORMAT(InvoiceDate,'MM-yyyy') as Date,
Month(InvoiceDate) as Month,
YEAR(InvoiceDate) as Year,
StockCode,
ROW_NUMBER() OVER(PARTITION BY FORMAT(InvoiceDate,'MM-yyyy') ORDER BY SUM(Quantity * UnitPrice) DESC) AS rn
FROM clean_transonly
GROUP BY YEAR(InvoiceDate),FORMAT(InvoiceDate,'MM-yyyy') ,Month(InvoiceDate) ,StockCode) t

WHERE t.rn <= 10
ORDER BY YEAR ASC,Date, Month ,rn 



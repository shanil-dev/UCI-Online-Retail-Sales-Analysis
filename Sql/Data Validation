--GEOGRAPHIC ANALYSIS


--MOST REVENUE GENERATE COUNTRY

SELECT TOP 1 Country,ROUND(SUM(Quantity * UnitPrice),2) AS Revenue
FROM clean_transonly
GROUP BY Country
ORDER BY Revenue DESC


--TOTAL ORDERS,CUSTOMER AND QUANTITY SOLD BY EACH COUNTRY

SELECT Country, SUM(Quantity) As TotalItemSold,
Count( DISTINCT InvoiceNo) as TotalOrders,
COUNT(DISTINCT(CustomerID)) as Customer
FROM clean_transonly
GROUP BY Country
ORDER BY TotalItemSold DESC


--MOST DEMANDED PRODUCT IN EACH COUNTRY

With order1 As
(SELECT Country, SUM(Quantity) As TotalItemSold,
StockCode,
ROW_NUMBER() OVER(PARTITION BY Country ORDER BY SUM(Quantity) DESC) as rn
FROM clean_transonly
GROUP BY Country,StockCode
)

SELECT Country,TotalItemSold,StockCode,rn
FROM order1
WHERE rn <= 10
ORDER BY TotalItemSold Desc,rn Desc,Country




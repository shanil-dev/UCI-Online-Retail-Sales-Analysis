-- CREATING A VIEW FOR CLEANED DATE-----



;CREATE VIEW clean_transonly AS
SELECT 
    InvoiceNo,
    StockCode,
    Description,
    Quantity,
    InvoiceDate,
    UnitPrice,
    CustomerID,
    Country
FROM uci_sales
WHERE 
   UnitPrice > 0
  AND Quantity > 0
  ;


------------------------------------- DATA VALIDATION----------------------------------------------


--SALES----


--Overall Sales Performance

SELECT FORMAT(SUM(Quantity * UnitPrice)/1000,'#,00.0'+'K') AS Revenue, 
CONCAT((SUM(Quantity)/1000),'K') AS TotalUnitSold,
CONCAT(COUNT(DISTINCT InvoiceNo)/1000,'K') AS TotalOrders
FROM uci_sales
WHERE 
Quantity > 0
AND
UnitPrice > 0
AND 
InvoiceNo NOT LIKE '%C%'


SELECT FORMAT(SUM(Quantity * UnitPrice)/1000.0,'#,00.0'+'K') AS Revenue 
FROM clean_transonly


--SALE TREND OVER TIME

SELECT FORMAT(SUM(Quantity * UnitPrice)/1000.0,'#,00.0'+'K') AS Revenue,FORMAT(InvoiceDate,'MM-yyyy') as Month
FROM clean_transonly
GROUP BY FORMAT(InvoiceDate,'MM-yyyy')
ORDER BY MIN(InvoiceDate)


--MONTH WITH LOWEST REVENUE---

SELECT FORMAT(SUM(Quantity * UnitPrice)/1000,'#,00.0')+'K' AS Revenue,FORMAT(InvoiceDate,'MM-yyyy') as MOnth
FROM clean_transonly
GROUP BY FORMAT(InvoiceDate,'MM-yyyy') 
ORDER BY SUM(Quantity * UnitPrice) ASC
OFFSET 0 ROWS
FETCH NEXT 1 ROWS ONLY


--ORDER,QUANTITY,REVENUE OF LOWEST MONTH

SELECT FORMAT(SUM(Quantity * UnitPrice)/1000,'#,00.0'+'K') AS Revenue, 
CONCAT((SUM(Quantity)/1000),'K') AS TotalUnitSold,
COUNT(DISTINCT InvoiceNo) AS TotalOrders,
FORMAT(InvoiceDate,'MM-yyyy') As Date
FROM clean_transonly
WHERE FORMAT(InvoiceDate,'MM-yyyy') ='04-2011'
GROUP BY FORMAT(InvoiceDate,'MM-yyyy') 
--ORDER BY SUM(Quantity * UnitPrice)/1000.0 ASC


--MoM Sale Diff and Growth

SELECT  YEAR(InvoiceDate) AS YEAR,
	   MONTH(InvoiceDate) AS MONTH,
        ROUND(SUM(Quantity * UnitPrice),2) As Revenue ,
	   ISNULL(FORMAT(LAG(SUM(Quantity * UnitPrice),1) OVER( ORDER BY YEAR(InvoiceDate),MONTH(InvoiceDate))/1000.0,'#,0K'),'No Previous Sales') AS PreviouMonthSale,


	  ISNULL( FORMAT((SUM(Quantity * UnitPrice) - NULLIF(LAG(SUM(Quantity * UnitPrice),1) OVER( ORDER BY YEAR(InvoiceDate),MONTH(InvoiceDate)),0))/1000.0,'#0,0K'),'No Previous Sales')AS SALEDIFF,

	  ISNULL(FORMAT( (( SUM(Quantity * UnitPrice) - NULLIF(LAG(SUM(Quantity * UnitPrice),1) OVER( ORDER BY YEAR(InvoiceDate),MONTH(InvoiceDate)),0))* 100.0)
	   / NULLIF(LAG(SUM(Quantity * UnitPrice),1) OVER( ORDER BY YEAR(InvoiceDate),MONTH(InvoiceDate)),0) ,'#0.0')+'%','N0 Previous MonthSale') AS MoMGrowth
	  
FROM clean_transonly
GROUP BY YEAR(InvoiceDate),
	   MONTH(InvoiceDate)


;WITH MonthlySales AS (
    SELECT 
        YEAR(InvoiceDate) AS [Year],
        MONTH(InvoiceDate) AS [Month],
        ROUND(SUM(Quantity * UnitPrice), 2) AS Revenue
    FROM clean_transonly
    GROUP BY 
        YEAR(InvoiceDate),
        MONTH(InvoiceDate)
)
SELECT 
    [Year],
    [Month],
    Revenue,
    LAG(Revenue, 1) OVER (ORDER BY [Year], [Month]) AS PreviousMonthSale,
    Revenue - LAG(Revenue, 1) OVER (ORDER BY [Year], [Month]) AS SaleDiff,
    ROUND(
        ((Revenue - LAG(Revenue, 1) OVER (ORDER BY [Year], [Month])) * 100.0) 
        / NULLIF(LAG(Revenue, 1) OVER (ORDER BY [Year], [Month]), 0), 
    2) AS MoMGrowth
FROM MonthlySales
ORDER BY [Year], [Month];



---MoM Order Diff & Growth

;With Orders As (
   SELECT YEAR(InvoiceDate) As YEAR,
          MONTH(InvoiceDate) As MONTH,
          COUNT(DISTINCT InvoiceNo) As TotalOrders
   FROM clean_transonly
   GROUP BY YEAR(InvoiceDate) ,
          MONTH(InvoiceDate)
          )


SELECT YEAR,MONTH,TotalOrders,
       ISNULL(FORMAT(LAG(TotalOrders,1) OVER(ORDER BY YEAR,MONTH)/1000.0,'#.0K'),'NoPreviousOrders') AS PreviousMonthOrders,

      ISNULL(FORMAT((TotalOrders - (LAG(TotalOrders,1) OVER(ORDER BY YEAR,MONTH)))/1000.0,'#.0K'),'NoPreviousMonthOrders') as OrderDiff,


      ISNULL(FORMAT((TotalOrders - LAG(TotalOrders,1) OVER(ORDER BY YEAR,MONTH))*100.0
      /NULLIF(LAG(TotalOrders,1) OVER(ORDER BY YEAR,MONTH),0),'#0.0')+'%','NoPreviousMonthOrders') as MoM_Growth
       
FROM Orders
ORDER BY YEAR,MONTH





--CUSTOMER--

--CUSTOMER CONDRIBUTED TO HIGHEST REVENUE

SELECT TOP 1 CustomerID,
SUM(Quantity * UnitPrice) AS Revenue
FROM clean_transonly
WHERE CustomerID <> 'Unknown'
GROUP BY CustomerID
ORDER BY Revenue DESC                   --Null Customer id is not considered


--- TOTAL CUSTOMER BASE

SELECT COUNT(DISTINCT CustomerID) as TotalCustomerID
FROM clean_transonly



----AVERAGE REVENUE PER CUSTOMER

SELECT ROUND(SUM(Quantity * UnitPrice),2) AS Revenue,
COUNT(DISTINCT CustomerID) as TotalCustomerID,
FORMAT(ROUND(SUM(Quantity * UnitPrice)/COUNT(DISTINCT CustomerID),2),'C') as AverageRevenuePerCustomer
FROM clean_transonly
WHERE CustomerID <>'Unknown'

--SINGLE PURCHASE CUSTOMER

SELECT CustomerID
FROM clean_transonly
GROUP BY CustomerID 
HAVING Count(DISTINCT InvoiceNo)=1



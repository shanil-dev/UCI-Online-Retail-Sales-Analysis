--CANCELLETION ANALYSIS


--ITEM WITH HIGHEST NUMBER OF CANCELLETION

SELECT TOP 5 StockCode ,COUNT(InvoiceNo) As TotalOrders,ROUND(SUM(Quantity * UnitPrice),2) AS LostRevenue,
SUM(Quantity) as TotalReturned,UnitPrice
FROM uci_sales
WHERE InvoiceNo LIKE '%C%'
GROUP BY StockCode ,UnitPrice
ORDER BY TotalReturned ASC


--ITEM WITH MOST REVENUE LOST BY CANCELLETION

SELECT TOP 5 StockCode ,COUNT( DISTINCT InvoiceNo) As TotalOrders,ROUND(SUM(Quantity * UnitPrice),2) AS LostRevenue,
SUM(Quantity) as TotalReturned,UnitPrice
FROM uci_sales
WHERE InvoiceNo LIKE '%C%'
GROUP BY StockCode ,UnitPrice
ORDER BY LostRevenue ASC


--Overal Cancelletion Rate--

SELECT COUNT(DISTINCT InvoiceNo) as TotalOrders,
	   COUNT(DISTINCT CASE WHEN InvoiceNo LIKE '%C%' THEN InvoiceNo END ) as CancelledOrders,
       CONCAT( 
	   (CAST(COUNT(DISTINCT CASE WHEN InvoiceNo LIKE '%C%' THEN InvoiceNo END )AS FLOAT)/COUNT(DISTINCT InvoiceNo))*100 
	   ,'%') as CancelledRate
FROM uci_sales


--Cancelled Quantity

SELECT 
		SUM( CASE 
		      WHEN InvoiceNo Like '%C%' THEN ABS(Quantity) ELSE 0 END) as CanceledQuantity
        FROM uci_sales
